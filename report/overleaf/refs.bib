% References in IEEE style (BibTeX style cs259ieee.bst, a renamed copy of IEEEtran.bst 1.14 with `doi' and `urldate' fields added).
% Fields were checked against the Crossref record of each DOI, the arXiv record, and the web page itself;
% provenance of every field is in docs/reference_verification.md, re-check of 2026-11-16 in docs/reference_check_2026-11-16.md.
%
% Order: this style does not sort. The course template asks for a numbered list ordered alphabetically by first author,
% so main.tex cites every key once, in alphabetical order, with \nocite before the first \cite. When a reference is added,
% insert its key at the right place in that \nocite list.
%
% Titles are written in sentence case and journal / proceedings names are abbreviated, as IEEE style requires.
% The `note' of the two entries with an article number carries the DOI as well (the style would otherwise put a period between them).
% For documents with a DOI only the DOI is printed (no extra URL); web documents carry `url' and the access date in `urldate'.

@IEEEtranBSTCTL{IEEEexample:BSTcontrol,
  CTLuse_forced_etal       = "yes",
  CTLmax_names_forced_etal = "6",
  CTLnames_show_etal       = "1",
  CTLuse_article_number    = "yes",
  CTLuse_url               = "yes",
  CTLuse_alt_spacing       = "no",
  CTLdash_repeated_names   = "no"
}
% CTLuse_forced_etal / CTLmax_names_forced_etal / CTLnames_show_etal: more than 6 authors -> first author followed by "et al."

